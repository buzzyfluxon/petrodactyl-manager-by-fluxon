# Copy this file to config.env and fill in your own values.
# Never commit your real config.env — it's already in .gitignore.

BOT_TOKEN="your-discord-bot-token"
BOT_CLIENT_ID="your-bot-client-id"
BOT_SINGLE_SERVER_ID="your-guild-id"

PTERODACTYL_API_KEY="ptla_your-application-api-key"
PTERODACTYL_ACCOUNT_API_KEY="ptlc_your-client-api-key"
PTERODACTYL_API_URL="https://your-panel-domain.com"

DELETION_OFFSET=2
PRICE_OFFSET=0.75
ADMIN_LIST=[]

FOOTER_TEXT="Your Brand 2026"
DEFAULT_LANGUAGE="en-US"
BOT_PREFIX=">"
OWNER_IDS="your-discord-user-id"

# --- Channel IDs ---
LOG_CHANNEL_ID="channel-id-for-server-creation-logs"
PAID_LOG_CHANNEL_ID="channel-id-for-paid-server-logs"
NOTIFY_CHANNEL_ID="channel-id-for-expiry-renewal-notices"
CLEANUP_NOTIFY_CHANNEL_ID="channel-id-for-auto-cleanup-notices"
BOOST_CHANNEL_ID="channel-id-for-booster-perks"

# --- Role IDs ---
PAID_ROLE_ID="role-id-granted-to-paid-users"
PLAN_ROLE_ID="role-id-allowed-to-manage-plans"

# --- Emoji IDs (custom emoji format: <:name:id> or <a:name:id> for animated) ---
EMOJI_WARN="<:warn:0000000000000000>"
EMOJI_ONLINE="<a:online:0000000000000000>"
EMOJI_OFFLINE="<a:offline:0000000000000000>"
